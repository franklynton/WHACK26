# Copy to .env.local and fill in. Never commit .env.local.
# Without a key, the narrator uses canned lines so the demo still works.
OPENROUTER_API_KEY=
# Optional: defaults to the free router. A paid model (e.g. a Claude or GPT model) is far more reliable at JSON.
OPENROUTER_MODEL=openrouter/free

# Supabase project (Settings > API). The anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
